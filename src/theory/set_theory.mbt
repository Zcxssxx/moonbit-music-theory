///|
pub(all) struct PitchClassSet {
  pcs : Array[Int]
} derive(Eq, Debug)

///|
pub fn PitchClassSet::new(arr : Array[Int]) -> PitchClassSet {
  let unique = []
  for val in arr {
    let pc = (val % 12 + 12) % 12
    let mut found = false
    for u in unique {
      if u == pc {
        found = true
        break
      }
    }
    if !found {
      unique.push(pc)
    }
  }

  // Sort ascending
  // Bubble sort is fine for small sets (max size 12)
  let len = unique.length()
  for i in 0..<len {
    for j in 0..<(len - 1 - i) {
      if unique[j] > unique[j + 1] {
        let tmp = unique[j]
        unique[j] = unique[j + 1]
        unique[j + 1] = tmp
      }
    }
  }
  { pcs: unique }
}

///|
pub fn PitchClassSet::from_notes(notes : Array[Note]) -> PitchClassSet {
  let pcs = notes.map(fn(n) {
    let base = n.letter.to_int()
    let acc = n.accidental.to_int()
    (base + acc % 12 + 12) % 12
  })
  PitchClassSet::new(pcs)
}

///|
pub fn PitchClassSet::to_string(self : PitchClassSet) -> String {
  let mut res = "["
  for i in 0..<self.pcs.length() {
    if i > 0 {
      res = res + ", "
    }
    res = res + self.pcs[i].to_string()
  }
  res = res + "]"
  res
}

///|
pub impl Show for PitchClassSet with fn output(self, logger) {
  logger.write_string(self.to_string())
}

///|
pub fn PitchClassSet::transpose(self : PitchClassSet, n : Int) -> PitchClassSet {
  let new_pcs = self.pcs.map(fn(pc) { (pc + n) % 12 })
  PitchClassSet::new(new_pcs)
}

///|
pub fn PitchClassSet::invert(self : PitchClassSet, n : Int) -> PitchClassSet {
  let new_pcs = self.pcs.map(fn(pc) { (n - pc + 12) % 12 })
  PitchClassSet::new(new_pcs)
}

// Compare two normal forms to see which is packed more to the left
// Returns true if a is packed more to the left than b

///|
fn compare_left_packed(a : Array[Int], b : Array[Int]) -> Bool {
  let len = a.length()
  if len != b.length() {
    return len < b.length()
  }
  if len <= 1 {
    return true
  }

  // Compare intervals from the first note: last to first, second-last to first, etc.
  let mut check_idx = len - 1
  while check_idx > 0 {
    let span_a = (a[check_idx] - a[0] + 12) % 12
    let span_b = (b[check_idx] - b[0] + 12) % 12
    if span_a != span_b {
      return span_a < span_b
    }
    check_idx = check_idx - 1
  }

  // If spans are identical, compare individual elements
  for i in 0..<len {
    if a[i] != b[i] {
      return a[i] < b[i]
    }
  }
  true
}

///|
pub fn PitchClassSet::normal_form(self : PitchClassSet) -> PitchClassSet {
  let original = self.pcs
  let len = original.length()
  if len == 0 {
    return { pcs: [] }
  }
  if len == 1 {
    return { pcs: [original[0]] }
  }

  // Generate all cyclic rotations
  let candidates = []
  for i in 0..<len {
    let candidate = []
    for j in 0..<len {
      candidate.push(original[(i + j) % len])
    }
    candidates.push(candidate)
  }

  // Sort rotations to find the one with the smallest span
  let mut best = candidates[0]
  for i in 1..<candidates.length() {
    let current = candidates[i]
    let span_best = (best[len - 1] - best[0] + 12) % 12
    let span_curr = (current[len - 1] - current[0] + 12) % 12

    if span_curr < span_best {
      best = current
    } else if span_curr == span_best {
      if compare_left_packed(current, best) {
        best = current
      }
    }
  }

  // Ensure best is sorted ascending (since it might wrap around, e.g. [11, 0, 4] is not ascending as 11 > 0)
  // Wait, in pitch class sets, the normal form is expressed in ascending order within an octave,
  // meaning each element is relative to the starting element.
  // E.g. rotation [11, 0, 4] is written as [11, 12, 16] or rather we add 12 to make it ascending:
  // [11, 0 + 12, 4 + 12] = [11, 12, 16], then reduced modulo 12: [11, 0, 4].
  // Actually, we can keep the order generated by the rotation!
  // Wait! A standard pitch class set representation of normal form keeps the rotation order:
  // e.g. [11, 0, 3] is ascending if we consider 11 -> 0 (+1) -> 3 (+3).
  // Let's return the rotation array directly!
  { pcs: best }
}

///|
pub fn PitchClassSet::prime_form(self : PitchClassSet) -> PitchClassSet {
  let len = self.pcs.length()
  if len == 0 {
    return { pcs: [] }
  }

  // Get normal form
  let nf = self.normal_form()
  // Transpose to 0
  let t0 = nf.transpose((12 - nf.pcs[0]) % 12)

  // Invert the original set, get its normal form, transpose to 0
  let inverted = self.invert(0)
  let inf = inverted.normal_form()
  let it0 = inf.transpose((12 - inf.pcs[0]) % 12)

  // Compare t0 and it0, choose the one packed most to the left
  let best = if compare_left_packed(t0.pcs, it0.pcs) { t0.pcs } else { it0.pcs }

  { pcs: best }
}

///|
pub fn PitchClassSet::interval_class_vector(self : PitchClassSet) -> Array[Int] {
  let vector = [0, 0, 0, 0, 0, 0]
  let len = self.pcs.length()
  if len <= 1 {
    return vector
  }

  for i in 0..<len {
    for j in (i + 1)..<len {
      let diff = (self.pcs[i] - self.pcs[j]).abs()
      let ic = if diff > 6 { 12 - diff } else { diff }
      if ic >= 1 && ic <= 6 {
        vector[ic - 1] = vector[ic - 1] + 1
      }
    }
  }
  vector
}
